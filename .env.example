# Copy to backend/.env. Optional: without a key the app runs on projections only.
ODDS_API_KEY=
# spare keys (optional): a sync switches to them once the key above reaches ODDS_CREDIT_FLOOR
ODDS_API_KEY_NFL_SECONDARY=
# NBA lines use their own key (optional; without it the NBA side shows projections only)
ODDS_API_KEY_NBA=
ODDS_API_KEY_NBA_SECONDARY=
# DATABASE_URL=postgresql+psycopg://user:pass@host/dbname   # default is a local SQLite file
